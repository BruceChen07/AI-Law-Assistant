      "risk_level": "high|medium|low|pending",
      "issue": "风险问题描述（简洁明确）",
      "original_clause_quote": "合同原文精确片段",
      "clause_location": "条款位置（如第X条第Y款）",
      "case_reference": {
        "case_number": "参考判例案号",
